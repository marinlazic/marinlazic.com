// Copies the content skill's style guide and channel specs into a TypeScript
// module so the server can bundle them. The markdown in
// .claude/skills/content is the source. Run with: tsx scripts/build-studio-rules.mts
// It runs at the start of every build; the output is committed so tests and
// type checks work without running it first.
import fs from "node:fs";
import path from "node:path";

const root = path.resolve(import.meta.dirname, "..");
const skill = path.join(root, ".claude/skills/content");
const out = path.join(root, "server/studioRules.generated.ts");

const styleGuide = fs.readFileSync(path.join(skill, "style-guide.md"), "utf8");
const formats: Record<string, string> = {};
for (const f of fs.readdirSync(path.join(skill, "formats")).sort()) {
  if (!f.endsWith(".md")) continue;
  formats[f.replace(/\.md$/, "")] = fs.readFileSync(path.join(skill, "formats", f), "utf8");
}

const body = `// Generated by scripts/build-studio-rules.mts from .claude/skills/content. Do not edit here.
export const STYLE_GUIDE = ${JSON.stringify(styleGuide)};
export const FORMATS: Record<string, string> = ${JSON.stringify(formats, null, 2)};
`;
const current = fs.existsSync(out) ? fs.readFileSync(out, "utf8") : "";
if (current !== body) {
  fs.writeFileSync(out, body);
  console.log(`[studio-rules] wrote ${path.relative(root, out)} (${Object.keys(formats).length} channels)`);
} else {
  console.log("[studio-rules] up to date");
}
