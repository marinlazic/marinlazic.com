# Copy to .env for local development. On Vercel, set these in Project Settings, Environment Variables.

# Postgres connection string (Neon). Use the pooled connection string.
DATABASE_URL=

# Long random string used to sign the admin session cookie.
JWT_SECRET=

# Password for /admin.
ADMIN_PASSWORD=
ADMIN_EMAIL=marin@marinlazic.coach

# Where owner notifications go.
OWNER_EMAIL=marin@marinlazic.coach

# Resend (transactional email). The from address must be on a verified domain.
RESEND_API_KEY=
RESEND_FROM_EMAIL="Marin Lazic <results@marinlazic.com>"

# Kit (ConvertKit) v4 API key.
KIT_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Google Gemini API key for the assessment report.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Vercel Blob read write token (set automatically when a Blob store is linked).
BLOB_READ_WRITE_TOKEN=

# Shared secret for the daily scheduled job (Vercel sends it automatically).
CRON_SECRET=

# Public origin used in emails and links.
CANONICAL_ORIGIN=https://marinlazic.com

# Gmail connection for the Follow up section (Google Cloud OAuth client, read only Gmail scope)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
